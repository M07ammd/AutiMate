# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=autimate_db
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/autimate_db?schema=public

# Backend API Configuration
APP_URL=http://localhost:4000
PORT=4000

# Authentication (JWT Secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email Configuration (e.g., Mailtrap, Gmail)
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass
GMAIL_USER=your_gmail_user
GMAIL_PASS=your_gmail_pass

# AI Services Configuration
AI_API_URL=http://ai-services:5000/predict

# External API Keys (CRITICAL: Rotate any previously exposed keys)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Eye Tracking Configuration
EYE_TRACKING_URL=http://eye-tracking:8000
